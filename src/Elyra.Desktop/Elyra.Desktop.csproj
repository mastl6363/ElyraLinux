<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Elyra</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>Elyra.Desktop</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="LibVLCSharp" Version="3.9.7.1" />
        <PackageReference Include="TagLibSharp" Version="2.3.0" />
    </ItemGroup>

    <!-- Reuse the shared, framework-agnostic Razor UI, models and services from
         ../Elyra.Shared instead of a second copy. Maui-only code paths inside
         Elyra.Shared/Services are compiled out here via
         #if ANDROID || IOS || MACCATALYST || WINDOWS (undefined on this plain
         net10.0 TFM) — that guard is a leftover from Elyra.Shared also being
         used by the original MAUI app (github.com/mastl6363/elyra) and is kept
         so the two stay easy to keep in sync. -->
    <ItemGroup>
        <Compile Include="../Elyra.Shared/Components/**/*.razor.cs">
            <Link>Components/%(RecursiveDir)%(Filename)%(Extension)</Link>
        </Compile>
        <Compile Include="../Elyra.Shared/Models/**/*.cs">
            <Link>Models/%(RecursiveDir)%(Filename)%(Extension)</Link>
        </Compile>
        <Compile Include="../Elyra.Shared/Services/**/*.cs">
            <Link>Services/%(RecursiveDir)%(Filename)%(Extension)</Link>
        </Compile>

        <RazorComponent Include="../Elyra.Shared/Components/**/*.razor">
            <Link>Components/%(RecursiveDir)%(Filename)%(Extension)</Link>
        </RazorComponent>

        <Content Include="../Elyra.Shared/wwwroot/**">
            <Link>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <!-- Tailwind build pipeline, reading from Elyra.Shared's source and writing
         its generated stylesheet, so both a MAUI sibling build (if you keep one
         around) and this desktop host share the exact same CSS. -->
    <PropertyGroup>
        <TailwindOutput>../Elyra.Shared/wwwroot/css/app.css</TailwindOutput>
    </PropertyGroup>

    <Target Name="EnsureTailwindCss" BeforeTargets="BeforeBuild;BeforeRebuild" Condition="!Exists('$(TailwindOutput)')">
        <Exec Command="npm install" WorkingDirectory="../Elyra.Shared" />
        <Exec Command="npm run css:build" WorkingDirectory="../Elyra.Shared" />
    </Target>

</Project>
